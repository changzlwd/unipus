		cp-key-en-gpio = <&tlmm 78 0x01>;

		vol_up {
			label = "volume_up";
			gpios = <&pmxr2230_gpios 6 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEUP>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		};

		 scan_lkey {
			label = "scan_lkey";
			gpios = <&tlmm 149 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2ef>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
