&pm8550vs_d {
	status = "disabled";
};

&pm8550vs_d_temp_alarm {
	status = "disabled";
};

&pm8550vs_e {
	status = "disabled";
};

&pm8550vs_e_temp_alarm {
	status = "disabled";
};

&pm8550vs_g {
	status = "disabled";
