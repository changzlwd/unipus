			function = "normal";
			bias-disable;
			output-high;
			power-source = <1>;
		};
	};

	s1j_enable_pin {
		s1j_enable_default: s1j_enable_default {
			pins = "gpio1";
			function = "normal";
			bias-disable;
			output-low;
			power-source = <0>;
		};
	};
};

