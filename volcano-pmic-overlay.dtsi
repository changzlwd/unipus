			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEUP>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		};

		 scan_lkey {
			label = "scan_lkey";
			gpios = <&tlmm 149 GPIO_ACTIVE_LOW>;
