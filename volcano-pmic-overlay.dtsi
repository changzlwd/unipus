&pmxr2230_gpios {
key_vol_up {
	key_vol_up_default: key_vol_up_default {
			pins = "gpio6";
			function = "normal";
			input-enable;
			bias-pull-up;
			power-source = <1>;
		};
	};

	sys_therm_6_gpio7 {
		sys_therm_6_gpio7_default: sys_therm_6_gpio7_default {
			pins = "gpio7";
