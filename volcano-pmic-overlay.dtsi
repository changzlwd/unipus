&pm8550vs_d {
	status = "disabled";
};

&pm8550vs_d_temp_alarm {
	status = "disabled";
};

&pm8550vs_e {
	status = "disabled";
};

&pm8550vs_e_temp_alarm {
	status = "disabled";
};

&pm8550vs_g {
	status = "disabled";
};

&pm8550vs_g_temp_alarm {
	status = "disabled";
};

&pmxr2230_gpios {
key_vol_up {
	key_vol_up_default: key_vol_up_default {
			pins = "gpio6";
			function = "normal";
			input-enable;
			bias-pull-up;
			power-source = <1>;
		};
	};

	sys_therm_6_gpio7 {
		sys_therm_6_gpio7_default: sys_therm_6_gpio7_default {
			pins = "gpio7";
			bias-high-impedance;
		};
	};
};

&soc {
	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default &gpio_key_active>;
		cp-key-en-gpio = <&tlmm 78 0x01>;

		vol_up {
			label = "volume_up";
			gpios = <&pmxr2230_gpios 6 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEUP>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		};

		 scan_lkey {
			label = "scan_lkey";
			gpios = <&tlmm 149 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2ef>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		 };
		 scan_rkey {
			label = "scan_rkey";
			gpios = <&tlmm 150 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f0>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		 };
		 cp_key {
			label = "cp_key";
			gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f1>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
			};
	};
};

&tlmm{
	gpio_key_active: gpio_key_active {
		mux {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			function = "gpio";
		};
		config {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&pmk8550_gpios {
	pinctrl-0 = <&alt_sleep_clk_default>;
	pinctrl-names = "default";

	alt_sleep_clk {
		alt_sleep_clk_default: alt_sleep_clk_default {
			pins = "gpio5";
			function = "func1";
			input-disable;
			output-enable;
			bias-disable;
			power-source = <0>;
		};
	};
};

&pmr735b_gpios {
	pm8010m_reset {
		pm8010m_active: pm8010m_active {
			pins = "gpio3";
			function = "normal";
			bias-disable;
			output-high;
			power-source = <1>;
		};
	};

	pm8010n_reset {
		pm8010n_active: pm8010n_active {
			pins = "gpio4";
			function = "normal";
			bias-disable;
			output-high;
			power-source = <1>;
		};
	};

	s1j_enable_pin {
		s1j_enable_default: s1j_enable_default {
			pins = "gpio1";
			function = "normal";
			bias-disable;
			output-low;
			power-source = <0>;
		};
	};
};

