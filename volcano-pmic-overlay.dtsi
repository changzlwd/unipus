			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
			};
	};
};

&tlmm{
	gpio_key_active: gpio_key_active {
		mux {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			function = "gpio";
		};
		config {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

