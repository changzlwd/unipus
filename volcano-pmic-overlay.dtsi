			linux,code = <0x2ef>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		 };
		 scan_rkey {
			label = "scan_rkey";
			gpios = <&tlmm 150 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f0>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		 };
		 cp_key {
			label = "cp_key";
			gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f1>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
			};
	};
};

&tlmm{
	gpio_key_active: gpio_key_active {
		mux {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			function = "gpio";
		};
		config {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&pmk8550_gpios {
	pinctrl-0 = <&alt_sleep_clk_default>;
	pinctrl-names = "default";

	alt_sleep_clk {
		alt_sleep_clk_default: alt_sleep_clk_default {
			pins = "gpio5";
			function = "func1";
			input-disable;
			output-enable;
			bias-disable;
			power-source = <0>;
		};
	};
};

&pmr735b_gpios {
	pm8010m_reset {
		pm8010m_active: pm8010m_active {
			pins = "gpio3";
			function = "normal";
			bias-disable;
			output-high;
			power-source = <1>;
		};
	};

	pm8010n_reset {
		pm8010n_active: pm8010n_active {
			pins = "gpio4";
			function = "normal";
			bias-disable;
			output-high;
			power-source = <1>;
		};
	};

	s1j_enable_pin {
		s1j_enable_default: s1j_enable_default {
			pins = "gpio1";
			function = "normal";
			bias-disable;
			output-low;
			power-source = <0>;
		};
	};
};

