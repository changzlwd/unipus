&soc {
	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default &gpio_key_active>;
		cp-key-en-gpio = <&tlmm 78 0x01>;

		vol_up {
			label = "volume_up";
			gpios = <&pmxr2230_gpios 6 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEUP>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		};

		 scan_lkey {
			label = "scan_lkey";
			gpios = <&tlmm 149 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2ef>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		 };
		 scan_rkey {
			label = "scan_rkey";
			gpios = <&tlmm 150 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f0>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		 };
		 cp_key {
			label = "cp_key";
			gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f1>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
			};
	};
};

&tlmm{
	gpio_key_active: gpio_key_active {
		mux {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			function = "gpio";
		};
		config {
			pins = "gpio149", "gpio150", "gpio75", "gpio78";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&pmk8550_gpios {
	pinctrl-0 = <&alt_sleep_clk_default>;
	pinctrl-names = "default";

	alt_sleep_clk {
