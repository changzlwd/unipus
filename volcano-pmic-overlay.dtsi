		torch-source = <&pmxr2230_torch2>;
		switch-source = <&pmxr2230_switch1>;
		status = "ok";
	};
};

&pmk8550_sdam_1 {
	ufs_dev: ufs_dev@96 {
		reg = <0x96 0x1>;
		bits = <0 0>;
