	qcom,led-mask = <9>;
	qcom,symmetry-en;
};

&pmxr2230_switch1 {
	qcom,led-mask = <6>;
	qcom,symmetry-en;
};

&pmxr2230_switch2 {
	qcom,led-mask = <15>;
