			label = "cp_key";
			gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f1>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
			};
	};
};

