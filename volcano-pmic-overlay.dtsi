		 scan_rkey {
			label = "scan_rkey";
			gpios = <&tlmm 150 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2f0>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
