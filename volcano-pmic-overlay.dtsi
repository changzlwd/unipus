			power-source = <1>;
		};
	};

	pm8010n_reset {
		pm8010n_active: pm8010n_active {
			pins = "gpio4";
			function = "normal";
			bias-disable;
			output-high;
			power-source = <1>;
		};
	};

	s1j_enable_pin {
		s1j_enable_default: s1j_enable_default {
			pins = "gpio1";
			function = "normal";
			bias-disable;
			output-low;
			power-source = <0>;
		};
	};
};

