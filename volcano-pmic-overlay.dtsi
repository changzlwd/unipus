		 scan_lkey {
			label = "scan_lkey";
			gpios = <&tlmm 149 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <0x2ef>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
