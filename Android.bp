cc_binary {
    name: "android.hardware.ir-service.volcano",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.ir-service.volcano.rc"],
    vintf_fragments: ["android.hardware.ir-service.volcano.xml"],
    srcs: [
        "ConsumerIr.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.ir-V1-ndk",
    ],
}
